# ============================================================
#  Starlight AI-CRM Mailer — .env.example
#  Copy this to .env and fill in your real values.
# ============================================================

# ── SaaS authentication ──────────────────────────────────────
SAAS_MODE=true
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRY_HOURS=168
# Bootstrap first admin (only when no users exist):
# SAAS_BOOTSTRAP_EMAIL=admin@yourcompany.com
# SAAS_BOOTSTRAP_PASSWORD=your-secure-password
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# ── Google Sign-In + Gmail send (any Google account) ─────────
# Create an OAuth 2.0 Web client in Google Cloud Console.
# App type: External (so personal Gmail works — do not restrict to a Workspace HD).
# Authorized redirect URIs must include BOTH (or at least the gmail one you set):
#   https://your-api/api/integrations/gmail/callback
#   https://your-api/api/auth/google/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://api.mailer.starlightlinearled.com/api/integrations/gmail/callback
# INTEGRATION_ENCRYPTION_KEY=  # Fernet key or passphrase for token encryption

# ── Sender details ───────────────────────────────────────────
SENDER_NAME=Vivek Dhondarkar
SENDER_COMPANY=Starlight LED Lighting
SENDER_PHONE=+91-9619436086
SENDER_WEBSITE=https://www.starlightlinearled.com
SENDER_EMAIL=info@starlightlinearled.com
COMPANY_LOGO_URL=https://i.ibb.co/b5NVtcS3/starlight.jpg

# ── Azure OpenAI ─────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# ── Catalogue page images (VPS only) ─────────────────────────
# Images are saved under static/page_images/ and served by the API at /media/...
# Cloudinary/Azure backends are disabled for catalogues.
BLOB_BACKEND=local
# Public base that already includes /media (production):
STATIC_SERVER_URL=https://api.mailer.starlightlinearled.com/media
# Or set API origin and /media is appended automatically:
# PUBLIC_API_URL=https://api.mailer.starlightlinearled.com
# Local API:
# STATIC_SERVER_URL=http://127.0.0.1:7860/media

# ── Google G Suite email sending ─────────────────────────────
GSUITE_SERVICE_ACCOUNT_JSON=service_account.json
GSUITE_DELEGATED_USER=vivek@starlightlinearled.com
# Domain-wide delegation must include gmail.send AND gmail.readonly (see README)
# Paste full JSON from GCP, OR base64-encode the file: base64 -w0 key.json
# GMAIL_POLL_INTERVAL_SEC=120

# ── OpenSERP (free self-hosted website discovery) ─────────────
# Used when a lead CSV/Excel has a company/name but no website.
# Local:  docker compose up openserp  → http://127.0.0.1:7000
# Docker: http://openserp:7000  (service name on the compose network)
OPENSERP_BASE_URL=http://127.0.0.1:7000
# OPENSERP_TIMEOUT=60
# OPENSERP_ENGINES=duckduckgo,bing,ecosia

# ── Persistent vector store (Neon PostgreSQL + pgvector) ───────
# Required for production on HuggingFace Spaces — local ChromaDB is wiped on redeploy.
# 1. Create a Neon project: https://neon.tech
# 2. Run in Neon SQL editor: CREATE EXTENSION IF NOT EXISTS vector;
# 3. Paste the connection string below (Settings → Secrets on HF Space)
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#
# Embedding dimension — must match your Azure embedding deployment output:
#   text-embedding-ada-002      → 1536 (default, auto-detected)
#   text-embedding-3-small      → 1536
#   text-embedding-3-large      → 3072
# Only set EMBEDDING_DIMENSION if auto-detection is wrong for your deployment name.
# EMBEDDING_DIMENSION=1536
